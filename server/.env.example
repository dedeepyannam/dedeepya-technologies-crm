# CRM Server Environment Variables Template
# Copy this file to .env and fill in the values for your local or production environment.

PORT=5000
NODE_ENV=production

# The URL of the frontend client (e.g. your Vercel deployment URL)
# Example: https://my-crm-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
# If using a managed database (like Render, AWS RDS, Neon), you can use a single connection string:
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Alternatively, you can provide individual variables if DATABASE_URL is not used:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=crm_db

# JWT Authentication Configuration
# Generate a strong, random string for this value in production (e.g. using `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
