# CRM Client Production Environment Variables
# This file is used when running `npm run build` for production deployment (e.g. on Vercel)

# Replace this with the actual URL of your deployed backend API (e.g. your Render deployment URL)
# Example: VITE_API_BASE_URL=https://my-crm-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://your-production-backend-url.com/api/v1
